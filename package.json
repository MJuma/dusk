{
    "name": "dusk",
    "private": true,
    "version": "0.0.0",
    "description": "A fast, dark-first Hacker News reader PWA",
    "type": "module",
    "packageManager": "pnpm@12.15.0",
    "engines": {
        "node": ">=22.12"
    },
    "scripts": {
        "dev": "vite",
        "build": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p src/sw/tsconfig.json && vite build",
        "preview": "vite preview",
        "lint": "oxlint -c oxlintrc.json --tsconfig tsconfig.json --type-aware src/ scripts/",
        "test": "vitest run",
        "fixtures": "node scripts/capture-fixture.mjs"
    },
    "dependencies": {
        "@preact/signals": "2.11.3",
        "idb": "8.0.4",
        "preact": "11.0.1",
        "workbox-core": "7.4.1",
        "workbox-expiration": "7.4.1",
        "workbox-precaching": "7.4.1",
        "workbox-routing": "7.4.1",
        "workbox-strategies": "7.4.1"
    },
    "devDependencies": {
        "@preact/preset-vite": "2.10.6",
        "@vite-pwa/assets-generator": "2.0.0",
        "jsdom": "30.1.3",
        "oxlint": "1.89.0",
        "oxlint-tsgolint": "7.0.2005",
        "playwright-core": "1.64.1",
        "typescript": "7.0.2",
        "vite": "8.3.5",
        "vite-plugin-pwa": "2.0.0",
        "vitest": "5.0.5",
        "workbox-window": "7.4.1"
    }
}
